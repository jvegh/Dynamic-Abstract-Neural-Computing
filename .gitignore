# This .gitignore is appropriate for repositories deployed to GitHub Pages and using
# a Gemfile as specified at https://github.com/github/pages-gem#conventional

# Basic Jekyll gitignores (synchronize to Jekyll.gitignore)
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
*.log
*.aux
*.glsdefs
*.ist
*.lof
*.lot
*Cache*
*.cache
*.autosave
*.user
CMakeCache.txt
CMakeFiles/*
doc/*.log
doc/manual/*.log
doc/manual/*.bbl
doc/manual/*.blg
doc/manual/*.aux
doc/manual/*.glsdefs
doc/manual/*.idx
doc/manual/*.ist
doc/manual/*.ilg
doc/manual/*.ind
doc/manual/*.lof
doc/manual/*.lot
doc/manual/*.toc
doc/manual/*.gz
doc/manual/*.xml
doc/manual/*.mt*
doc/manual/mwe.*
doc/book/*.log
doc/book/*.aux
doc/book/*.glsdefs
doc/book/*.idx
doc/book/*.ist
doc/book/*.ilg
doc/book/*.ind
doc/book/*.lof
doc/book/*.lot
doc/book/*.toc
doc/book/*.gz
doc/book/*.xml
doc/book/*.mt*
*.mtc*
*.bbl
*.blg
*.glo
*.idx
*.ind
*.maf
*.out
*.synctex.gz
*.toc
#docs/doxy/
#docs/manual/
code/build/
code/3rdParty/
CMakeLists.txt.user
../.qtcreator/CMakeLists.txt.user
code/.qtcreator/CMakeLists.txt.user
../.qtcreator/
code/.qtcreator/


# Specific ignore for GitHub Pages
# GitHub Pages will always use its own deployed version of pages-gem 
# This means GitHub Pages will NOT use your Gemfile.lock and therefore it is
# counterproductive to check this file into the repository.
# Details at https://github.com/github/pages-gem/issues/768
Gemfile.lock
